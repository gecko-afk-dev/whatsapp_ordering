# -- Database Configuration --
DB_USER=postgres
DB_PASSWORD=change_me_in_production
DB_NAME=whatsapp_food

# Inside Docker, docker-compose.yml overrides DATABASE_URL dynamically.
# For running outside Docker, this value is used directly.
DATABASE_URL=postgresql+asyncpg://postgres:change_me_in_production@localhost:5432/whatsapp_food

# -- Security --
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-before-production

